---
// Ficha do sujeito (SUJEITO) no layout do protótipo. Valores reais preenchidos no cliente. D3: i18n.
import HoodedFigure from './dossie/svg/HoodedFigure.astro';
import RedactBlock from './dossie/RedactBlock.astro';
import { subject as pt } from '../i18n/content/subject.pt';
import { subject as en } from '../i18n/content/subject.en';
import { langOf } from '../i18n/ui';
const c = langOf(Astro.currentLocale) === 'en' ? en : pt;
---
<div class="subject-grid">
  <div>
    <div class="field"><span class="k">{c.subject}</span><span class="v big"><span data-egg="nome">{c.placeholder}</span> <span style="color:var(--brasa2)">{c.you}</span></span></div>
    <div class="field"><span class="k">{c.location}</span><span class="v" data-egg="localizacao">—</span></div>
    <div class="field"><span class="k">{c.carrier}</span><span class="v" data-egg="operadora">—</span></div>
    <div class="field"><span class="k">{c.device}</span><span class="v" data-egg="maquina">—</span></div>
    <div class="field"><span class="k">{c.ip}</span><span class="v" data-egg="ip">—</span></div>
    <div class="status-line"><span class="k">{c.prediction}</span><br /><span class="v">{c.predictionValue}</span></div>
  </div>
  <div>
    <div class="mug">
      <HoodedFigure />
      <div class="grid-h"></div>
      <span class="corner c1"></span><span class="corner c2"></span>
      <span class="corner c3"></span><span class="corner c4"></span>
      <span class="scanid"></span>
    </div>
    <div class="mug-cap">{c.mugCap}</div>
  </div>
</div>

<div class="scores">
  {c.scores.map((s) => (
    <div class={s.danger ? 'score danger' : 'score'}><div class="lbl">{s.lbl}</div><div class="val">{s.val}</div><div class="bars">{s.bars}</div><div class="note">{s.note}</div></div>
  ))}
</div>

<div class="folha-tag">{c.analystTag}</div>
<RedactBlock>
  <p style="margin:0;" set:html={c.analystNote} />
</RedactBlock>

<script>
  import { fillEasterEggs } from '../features/dossie/fill-easter-eggs';
  fillEasterEggs();
</script>
