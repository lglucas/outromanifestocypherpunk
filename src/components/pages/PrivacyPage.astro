---
// Política de privacidade, compartilhada por `/privacidade` e `/en/privacy`. Sprint D3.
import DossieFrame from '../../layouts/DossieFrame.astro';
import { privacy as pt } from '../../i18n/content/privacy.pt';
import { privacy as en } from '../../i18n/content/privacy.en';
import type { Lang } from '../../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = lang === 'en' ? en : pt;
---
<DossieFrame lang={lang} routeKey="privacy" title={c.title} description={c.description}>
  <div class="folha-tag">{c.tag}</div>
  <h2 class="block">{c.h2a}<span class="accent">{c.h2b}</span></h2>
  <p class="docsub" style="max-width:640px;">{c.docsub}</p>

  <div class="pp">
    {c.sections.map((s) => (
      <>
        <h3>{s.h}</h3>
        <ul>{s.items.map((it) => <li set:html={it} />)}</ul>
      </>
    ))}

    <h3>{c.dntH}</h3>
    <p set:html={c.dntHtml} />

    <p class="pp-foot">{c.foot}</p>
  </div>

  <p class="hint">{c.hintA}<span>{c.hintB}</span></p>
</DossieFrame>

<style>
  .pp { max-width: 680px; }
  .pp h3 { font-family: var(--font-display); text-transform: uppercase; letter-spacing: .06em; color: var(--brasa-claro); font-size: 18px; margin: 26px 0 8px; }
  .pp ul { margin: 0; padding-left: 20px; }
  .pp li { margin: 6px 0; line-height: 1.6; }
  .pp :global(a) { color: var(--brasa-claro); }
  .pp-foot { font-family: var(--font-mono); font-size: 12px; color: var(--cinza-morto); margin-top: 24px; }
</style>
