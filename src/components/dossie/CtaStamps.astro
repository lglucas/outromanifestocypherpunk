---
// CTAs em carimbo: liberação (22/05/2028) + Amazon (ativa só quando AMAZON_URL existe). D3: i18n.
import { AMAZON_URL } from '../../config/links';
import { pathFor } from '../../i18n/routes';
import { t, langOf } from '../../i18n/ui';
const lang = langOf(Astro.currentLocale);
const d = t(lang);
---
<div class="cta-stamps">
  <a class="cta-stamp cta-free" href={pathFor('download', lang)}><span class="ink"></span>{d.ctaFree}</a>
  {AMAZON_URL ? (
    <a class="cta-stamp cta-buy" href={AMAZON_URL} target="_blank" rel="noopener"><span class="ink"></span>{d.ctaAmazon}</a>
  ) : (
    <span class="cta-stamp cta-buy cta-disabled"><span class="ink"></span>{d.ctaAmazonSoon}</span>
  )}
</div>

<style>
  .cta-disabled { cursor: default; opacity: .7; }
</style>
