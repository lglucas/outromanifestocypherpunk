---
// Botão discreto que limpa o cookie do portão e volta à home do idioma -> o terminal volta. D3: i18n.
import { pathFor } from '../i18n/routes';
import { t, langOf } from '../i18n/ui';
const lang = langOf(Astro.currentLocale);
---
<button class="reopen" data-reopen data-home={pathFor('home', lang)}>{t(lang).reopen}</button>

<style>
  .reopen { position: fixed; bottom: 12px; right: 12px; z-index: 50; background: transparent;
    border: 1px solid #3E5A6E; color: #5B7C92; font-family: 'IBM Plex Mono', monospace;
    font-size: 11px; padding: 4px 8px; cursor: pointer; }
  .reopen:hover { color: #E0731F; border-color: #E0731F; }
</style>

<script>
  const btn = document.querySelector<HTMLElement>('[data-reopen]');
  btn?.addEventListener('click', () => {
    document.cookie = 'livro_entered=; path=/; max-age=0';
    window.location.href = btn.dataset.home ?? '/';
  });
</script>
